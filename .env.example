# ---- Servidor ----
PORT=4000

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=documentos

# ---- IA (análisis de documentos y resúmenes - Google Gemini) ----
# Clave gratuita en https://aistudio.google.com/apikey
# Sin clave el sistema funciona normal y las funciones de IA aparecen como "sin configurar".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Modo demo: permite probar sin configurar Supabase Auth.
# Con DEMO_MODE=true el login valida solo el correo contra la tabla usuarios.
DEMO_MODE=true
